---
profile: production

skip_list:
  - name[missing]            # nechceme vynucovat name u každého tasku
  - yaml[line-length]        # dlouhé regexy atd.
  - command-instead-of-shell # víme, kdy shell používáme

warn_list:
  - risky-file-permissions
  - no-changed-when

exclude_paths:
  - .venv/
  - data/
